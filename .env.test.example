# Copy this file to .env.test and fill in a DISPOSABLE test database.
# Integration tests (tests/api/**) truncate every table before each test —
# never point this at your real dev/production database. A Neon branch
# created specifically for testing (Neon → Branches → Create branch) works
# well since it's a cheap copy-on-write clone of the schema.
#
# After creating .env.test, run migrations against it once:
#   set -a; source .env.test 2>/dev/null; npx prisma migrate deploy   (bash)
#   Get-Content .env.test | ... ; npx prisma migrate deploy            (adapt for PowerShell)
# or simplest: temporarily export TEST_DATABASE_URL as DATABASE_URL for one
# `npx prisma migrate deploy` run.
TEST_DATABASE_URL="postgresql://user:password@host/science_hub_test?sslmode=require"
