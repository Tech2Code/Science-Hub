generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Enables GIN trigram indexes below — global search's `contains`/ILIKE
  // queries can't use a plain btree index (only exact-prefix matches can),
  // so without pg_trgm every search does a full table scan. Fine at small
  // scale; degrades linearly as invoices/customers/products/etc. grow.
  extensions = [pg_trgm]
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  password              String
  role                  String               @default("staff")
  tokenVersion          Int                  @default(0)
  createdAt             DateTime             @default(now())
  invoices              Invoice[]
  activityLogs          ActivityLog[]
  resetTokens           PasswordResetToken[]
  purchaseBillsCreated  PurchaseBill[]       @relation("PurchaseBillCreator")
  stockMovementsCreated StockMovement[]      @relation("StockMovementCreator")
  sectionPermissions    SectionPermission[]
  rateLists             RateList[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  details    String
  entityId   String?
  entityType String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  invoices  Invoice[]

  @@index([deletedAt])
  // Global search matches Customer.name/phone/email/gstin with a `contains`
  // (ILIKE '%q%') query — a trigram index is what makes that fast instead of
  // a full table scan as the table grows.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([gstin(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  products  Product[]

  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  products  Product[]

  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Product {
  id                String             @id @default(cuid())
  name              String
  description       String?
  sku               String?            @unique
  barcode           String?
  hsn               String?
  unit              String             @default("Nos")
  price             Float
  purchasePrice     Float?
  gstRate           Float              @default(18)
  stock             Int                @default(0)
  minStock          Int                @default(5)
  // DB-generated (GENERATED ALWAYS AS (stock > 0 AND stock <= "minStock")
  // STORED) — "low stock" compares two columns of the same row, which a
  // plain Prisma `where` can't express directly; this lets the products
  // list filter/count it server-side via a normal boolean equality check.
  // Mirrors src/lib/stockStatus.ts's isLowStock() definition exactly.
  isLowStock        Boolean            @default(dbgenerated("(stock > 0 AND stock <= \"minStock\")"))
  maxStock          Int?
  reorderLevel      Int?
  categoryId        String?
  brandId           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  invoiceItems      InvoiceItem[]
  returnItems       ReturnItem[]
  purchaseBillItems PurchaseBillItem[]
  stockMovements    StockMovement[]
  brand             Brand?             @relation(fields: [brandId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])

  @@index([deletedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  dueDate       DateTime?
  customerId    String
  userId        String
  status        String        @default("unpaid")
  subtotal      Float
  cgst          Float         @default(0)
  sgst          Float         @default(0)
  igst          Float         @default(0)
  total         Float
  roundOff      Float         @default(0)
  paidAmount    Float         @default(0)
  // DB-generated (GENERATED ALWAYS AS (total - "paidAmount") STORED) — lets
  // "Balance Due (High-Low)" sort server-side via a normal orderBy instead of
  // needing raw SQL just for that one sort option. Never written to by the
  // app; Prisma omits dbgenerated() defaults from INSERT/UPDATE payloads.
  balanceDue    Float         @default(dbgenerated("(total - \"paidAmount\")"))
  notes         String?
  isInterState  Boolean       @default(false)
  placeOfSupply String?
  reverseCharge Boolean       @default(false)
  // Optional transport/freight charge — shown as its own line on the printed
  // invoice, with its own GST rate/amount, kept separate from cgst/sgst/igst
  // (which stay a pure sum of item-level tax) rather than folded into the
  // inter/intra-state split. transportChargeGstAmount is always server-
  // recomputed from charge × rate, never trusted from the client.
  transportCharge          Float @default(0)
  transportChargeGstRate   Float @default(0)
  transportChargeGstAmount Float @default(0)
  // Client-generated key (a UUID minted once per form session) so a retried/duplicated POST
  // (network timeout, double-tap) can't create a second invoice — nullable so existing rows and
  // any caller that doesn't send one are unaffected; the unique constraint is what actually
  // blocks the duplicate insert.
  idempotencyKey String?      @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  customer      Customer      @relation(fields: [customerId], references: [id])
  createdBy     User          @relation(fields: [userId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  returns       Return[]

  @@index([deletedAt])
  @@index([status])
  @@index([customerId])
  @@index([date])
  @@index([invoiceNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

model InvoiceItem {
  id                String  @id @default(cuid())
  invoiceId         String
  productId         String?
  name              String
  hsn               String  @default("")
  quantity          Float
  unit              String
  price             Float
  discountPercent   Float   @default(0)
  discountAmount    Float   @default(0)
  gstRate           Float
  gstAmount         Float
  total             Float
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   @default("cash")
  reference String?
  date      DateTime @default(now())
  notes     String?
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Same reasoning as Invoice.idempotencyKey — blocks a retried/duplicated record-payment POST
  // from creating a second payment row for the same submission.
  idempotencyKey String? @unique

  @@index([invoiceId])
  @@index([date])
}

model Return {
  id               String       @id @default(cuid())
  invoiceId        String
  invoice          Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creditNoteNumber String?      @unique // "CN-YYYY-0001" — nullable so pre-existing returns aren't retroactively renumbered
  date             DateTime     @default(now())
  notes            String?
  subtotal         Float        @default(0)
  cgst             Float        @default(0)
  sgst             Float        @default(0)
  igst             Float        @default(0)
  roundOff         Float        @default(0)
  total            Float        @default(0)
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?
  items            ReturnItem[]

  // Same reasoning as Invoice.idempotencyKey — blocks a retried/duplicated create POST from
  // consuming a second credit-note number and double-restoring stock.
  idempotencyKey   String?      @unique

  @@index([invoiceId])
  @@index([deletedAt])
  @@index([date])
}

model ReturnItem {
  id        String   @id @default(cuid())
  returnId  String
  return    Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Float
  price     Float
  gstRate   Float    @default(0)
  gstAmount Float    @default(0)
  total     Float
}

model BusinessSettings {
  id              String   @id @default("singleton")
  name            String   @default("Science Hub")
  tagline         String   @default("")
  logoUrl         String   @default("")
  email           String   @default("")
  phone           String   @default("")
  address         String   @default("")
  city            String   @default("")
  state           String   @default("")
  pincode         String   @default("")
  gstin           String   @default("")
  pan             String   @default("")
  gmailUser       String   @default("")
  gmailAppPassword String  @default("")
  bankName        String   @default("")
  bankAccountName String   @default("")
  bankAccountNumber String @default("")
  bankIfsc        String   @default("")
  bankBranch      String   @default("")
  termsAndConditions String @default("Interest @ 24%p.a would be charged after 45 days of Invoice\nMaterial sold strictly for lab use only\nWe are not responsible for any loss in transit.\nSubject to 'Delhi' Jurisdiction only.")
  showLogoOnInvoices Boolean @default(true)
  // Null = not customized yet. Invoice prefix falls back to initials derived
  // from `name` (see deriveDefaultPrefix in src/lib/documentNumbering.ts);
  // purchase bill prefix falls back to the fixed "PB" the app always used.
  // The "next" override is one-time-use: consumed and cleared back to null
  // the moment a create picks it up, so admins can raise the counter as
  // often as they like without it silently re-applying on a later invoice.
  invoiceNumberPrefix            String?
  nextInvoiceNumberOverride      Int?
  purchaseBillNumberPrefix       String?
  nextPurchaseBillNumberOverride Int?
  // Which layout the number is rendered in — see NumberFormatId /
  // NUMBER_FORMATS in src/lib/documentNumbering.ts. Null = the app's
  // original "PREFIX-FY-0001" layout.
  invoiceNumberFormat            String?
  purchaseBillNumberFormat       String?
  // Same pattern for credit notes (Return.creditNoteNumber) — prefix falls
  // back to the fixed "CN" the app always used.
  creditNoteNumberPrefix         String?
  nextCreditNoteNumberOverride   Int?
  creditNoteNumberFormat         String?
  updatedAt       DateTime @updatedAt
}

// ── Vendor Management ─────────────────────────────────────────────────────────

model Vendor {
  id            String          @id @default(cuid())
  name          String
  company       String?
  gstin         String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  purchaseBills PurchaseBill[]

  // Every list/stats query (vendorQuery.ts) filters `deletedAt: null` first —
  // missing this index (unlike every other soft-deletable model) meant a
  // full table scan on every vendor list/bin/dashboard query as the table grows.
  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ── Purchase Bills ────────────────────────────────────────────────────────────

model PurchaseBill {
  id              String            @id @default(cuid())
  billNumber      String            @unique
  vendorId        String
  vendor          Vendor            @relation(fields: [vendorId], references: [id])
  billDate        DateTime          @default(now())
  dueDate         DateTime?
  subtotal        Float             @default(0)
  taxAmount       Float             @default(0)
  isInterState    Boolean           @default(false)
  placeOfSupply   String?
  cgst            Float             @default(0)
  sgst            Float             @default(0)
  igst            Float             @default(0)
  discount        Float             @default(0)
  // Same shape/reasoning as Invoice.transportCharge — own line, own GST,
  // kept out of cgst/sgst/igst, server-recomputed from charge × rate.
  transportCharge          Float @default(0)
  transportChargeGstRate   Float @default(0)
  transportChargeGstAmount Float @default(0)
  // Same reasoning as Invoice.idempotencyKey — blocks a retried/duplicated create POST from
  // inserting a second bill.
  idempotencyKey  String?           @unique
  total           Float
  roundOff        Float             @default(0)
  paidAmount      Float             @default(0)
  // DB-generated (GENERATED ALWAYS AS (total - "paidAmount") STORED) — see
  // the matching Invoice.balanceDue field for why this exists.
  balanceDue      Float             @default(dbgenerated("(total - \"paidAmount\")"))
  status          String            @default("unpaid")   // unpaid | partial | paid | cancelled
  notes           String?
  attachmentUrl   String?
  attachmentName  String?
  category        String?
  createdByUserId String
  createdBy       User              @relation("PurchaseBillCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  items           PurchaseBillItem[]
  payments        PurchasePayment[]
  stockMovements  StockMovement[]

  @@index([deletedAt])
  @@index([vendorId])
  @@index([status])
  @@index([billDate])
  @@index([billNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PurchaseBillItem {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  name             String
  hsn              String       @default("")
  quantity         Float
  unit             String       @default("Nos")
  purchasePrice    Float
  discountPercent  Float        @default(0)
  discountAmount   Float        @default(0)
  gstRate          Float        @default(0)
  gstAmount        Float        @default(0)
  total            Float
}

// ── Purchase Payments ─────────────────────────────────────────────────────────

model PurchasePayment {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  amount         Float
  method         String       @default("cash")
  reference      String?
  date           DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  // Same reasoning as Payment.idempotencyKey.
  idempotencyKey String?      @unique

  @@index([purchaseBillId])
  @@index([date])
}

// ── Stock Movement Ledger ─────────────────────────────────────────────────────

model StockMovement {
  id             String        @id @default(cuid())
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String        @default("")
  // Specific action that produced this row — see StockMovementType in
  // src/lib/stockMovement.ts for the full set (e.g. sale, sale_edit_reverse,
  // purchase_cancel, return_bin_restore, manual). Never updated after
  // creation — every stock-affecting action writes a new row instead.
  type           String
  // Source document kind, derived 1:1 from `type` (see
  // DOCUMENT_TYPE_BY_MOVEMENT_TYPE) — invoice | purchase_bill | credit_note | manual
  documentType   String        @default("")
  quantity       Float         // positive = stock in, negative = stock out
  balanceAfter   Float
  reference      String?
  notes          String?
  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id])
  createdByUserId String?
  createdBy      User?         @relation("StockMovementCreator", fields: [createdByUserId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([documentType])
}

// ── Rate Lists (standalone product/price sheets, independent of Product catalog) ──

model RateList {
  id              String         @id @default(cuid())
  title           String
  note            String?
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  items           RateListItem[]

  @@index([deletedAt])
}

model RateListItem {
  id              String   @id @default(cuid())
  rateListId      String
  rateList        RateList @relation(fields: [rateListId], references: [id], onDelete: Cascade)
  serialNo        Int
  name            String
  brand           String?
  unit            String
  isNetRate       Boolean  @default(false)
  discountPercent Float    @default(0)
  listRate        Float
  amount          Float

  @@index([rateListId])
}

// ── Section Permissions (Access Control) ──────────────────────────────────────

model SectionPermission {
  id        String   @id @default(cuid())
  userId    String
  section   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
}
