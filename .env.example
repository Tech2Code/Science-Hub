# PostgreSQL (Neon) — use pooled URL in production (?pgbouncer=true&connection_limit=1)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Required in production — set to your deployed URL
NEXTAUTH_URL="https://your-app.vercel.app"

# Gmail — for sending invoice PDFs via email
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Vercel Blob — for the public store (business logo). Auto-set on Vercel once
# a Blob store is connected to the project; for local dev, run
# `vercel env pull` or copy the token from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Vercel Blob — dedicated PRIVATE store for purchase-bill attachments.
# Vercel renames this to LIVE_PRIVATE_BLOB_READ_WRITE_TOKEN (Production) /
# DEV_PRIVATE_BLOB_READ_WRITE_TOKEN (Preview) if a second Blob store is ever
# connected — see src/lib/blobStorage.ts for the fallback resolution order.
PRIVATE_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Optional — dedicated key for encrypting secrets-at-rest (Gmail app password,
# bank account number) independently of NEXTAUTH_SECRET. Without it, encryption
# still works, keyed off NEXTAUTH_SECRET instead. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
